# App
APP_NAME=ContentCard
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/contentcard

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (international)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_SMB=price_smb_id
STRIPE_PRICE_PRO=price_pro_id

# Paystack (Nigeria)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_PLAN_STARTER=PLN_xxx
PAYSTACK_PLAN_SMB=PLN_xxx
PAYSTACK_PLAN_PRO=PLN_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Free trial
FREE_TRIAL_DAYS=14

# CORS
FRONTEND_URL=http://localhost:5173

# Social autopilot
SOCIAL_AUTOPILOT_GLOBAL_KILL_SWITCH=false
SOCIAL_AUTOPILOT_MIN_QUALITY_SCORE=0.66
SOCIAL_DEDUPE_WINDOW_DAYS=30
SOCIAL_WEBHOOK_SECRET=replace-with-shared-secret-for-n8n-callback-signature
SOCIAL_N8N_BASE_URL=https://n8n.example.com
SOCIAL_OAUTH_STATE_SECRET=replace-with-long-random-secret
SOCIAL_OAUTH_CALLBACK_BASE_URL=https://contentcard-api.onrender.com
META_CLIENT_ID=
META_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SOCIAL_N8N_TOKEN_SINK_PATH=/webhook/contentcard/social/oauth-token

# Shopify auth
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_themes,read_content
SHOPIFY_OAUTH_STATE_SECRET=replace-with-long-random-secret
SHOPIFY_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/shopify/callback
SHOPIFY_AUTH_ENABLED=true
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Gmail SMTP (transactional + lifecycle email).
# Enable 2FA on the sending Gmail account, then create a 16-char App Password
# at https://myaccount.google.com/apppasswords and paste it as GMAIL_APP_PASSWORD.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=ContentCard
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# Email notification category kill-switches (default on).
EMAIL_GENERATION_LIFECYCLE_ENABLED=true
EMAIL_AUTOPILOT_HEALTH_ENABLED=true
