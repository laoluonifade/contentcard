# Copy this to backend/.env and fill in your values

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/contentcard

# ─── Auth ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── AI Provider ─────────────────────────────────────────────
# Set AI_PROVIDER to "anthropic" or "openai"
# If neither key is set, realistic dummy responses are used
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
